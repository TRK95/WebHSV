{
  "name": "elearning-news-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.20.0 <21"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./public/server.js",
    "start:render": "cross-env NODE_ENV=production ts-node --transpile-only server.ts",
    "dev": "cross-env NODE_ENV=development ts-node-dev --transpile-only --respawn --pretty server.ts",
    "pre-build": "grep -rl '\"outDir\": \"./public/\"' tsconfig.json | xargs sed -i 's#\"outDir\": \"./public/\"#\"outDir\": \"./build/\"#g'",
    "pre-build-mac": "grep -rl '\"outDir\": \"./public/\"' tsconfig.json | xargs sed -i '' 's#\"outDir\": \"./public/\"#\"outDir\": \"./build/\"#g'",
    "post-build": "grep -rl '\"outDir\": \"./build/\"' tsconfig.json | xargs sed -i 's#\"outDir\": \"./build/\"#\"outDir\": \"./public/\"#g'",
    "post-build-mac": "grep -rl '\"outDir\": \"./build/\"' tsconfig.json | xargs sed -i '' 's#\"outDir\": \"./build/\"#\"outDir\": \"./public/\"#g'",
    "build": "run-script-os",
    "build:windows:nix": "npm run pre-build && tsc -p . && npm run post-build && rm -rf public && mv build public",
    "build:macos": "npm run pre-build-mac && tsc -p . && npm run post-build-mac && rm -rf public && mv build public",
    "build:default": "npm run pre-build && tsc -p . && npm run post-build && rm -rf public && mv build public",
    "stage": "cross-env NODE_ENV=staging node ./public/server.js",
    "lint": "npx eslint ./ --ext .ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@elastic/elasticsearch": "7.10.0",
    "@google-cloud/storage": "5.3.0",
    "@types/axios": "^0.14.0",
    "@types/lodash": "4.14.176",
    "@types/mime-types": "~2.1.1",
    "@types/xlsx": "^0.0.36",
    "adm-zip": "^0.5.9",
    "axios": "^0.27.2",
    "config": "3.3.6",
    "cookie-parser": "1.4.5",
    "cors": "2.8.5",
    "crypto-js": "4.1.1",
    "date-fns": "2.21.3",
    "dateformat": "2.2.0",
    "dotenv": "10.0.0",
    "dotenv-expand": "5.1.0",
    "exceljs": "4.0.1",
    "express": "4.17.1",
    "firebase-admin": "9.9.0",
    "formidable": "1.2.2",
    "google-auth-library": "8.5.2",
    "helmet": "4.6.0",
    "ioredis": "4.19.4",
    "jsdom": "^20.0.0",
    "jsonwebtoken": "8.5.1",
    "mime-types": "~2.1.35",
    "moment": "2.29.1",
    "moment-duration-format": "2.3.2",
    "mongoose": "5.12.10",
    "multer": "^1.4.5-lts.1",
    "node-cron": "3.0.0",
    "node-fetch": "2.6.0",
    "node-mailjet": "^3.3.5",
    "node-xlsx": "0.16.1",
    "nodemon": "2.0.4",
    "p-queue": "6.6.2",
    "qs": "6.10.1",
    "read-excel-file": "4.0.6",
    "remove-accents": "0.4.2",
    "sendgrid": "5.2.3",
    "sha256": "0.2.0",
    "slugify": "^1.6.6",
    "socket.io": "4.1.1",
    "sqlite3": "^5.0.2",
    "ts-node": "9.1.1",
    "xlsx": "^0.18.5"
  },
