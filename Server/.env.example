PORT=3001

# MongoDB Atlas
# With the current legacy MongoDB driver, local Node 26 may need a single-host mongodb:// URI.
# For newer drivers, a normal mongodb+srv:// URI is preferred.
DB_URL=mongodb://<user>:<password>@<atlas-host>:27017/webhsv?ssl=true&authSource=admin&retryWrites=true&w=majority
DB_NAME=webhsv

URL_SERVER=http://localhost:3001

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Storage provider: "r2" for Cloudflare R2, "gcs" for Google Cloud Storage.
STORAGE_PROVIDER=r2
STORAGE_BASE_FOLDER=uploads

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BASE_FOLDER=uploads
# Optional. Set this only if you connect an R2 public bucket/custom domain for CMS images.
R2_PUBLIC_BASE_URL=

# Google Cloud Storage. Leave blank if using Cloudflare R2.
GCLOUD_STORAGE_PROJECT_ID=
GCLOUD_STORAGE_BUCKET=
GCLOUD_STORAGE_BASE_FOLDER=uploads
GCLOUD_STORAGE_CLIENT_EMAIL=
GCLOUD_STORAGE_CLIENT_ID=
GCLOUD_STORAGE_PRIVATE_KEY=
